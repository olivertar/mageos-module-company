<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="MageOS_Company::css/company.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="company.application.status"
                   template="MageOS_Company::application/status.phtml" cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">MageOS\Company\ViewModel\ApplicationStatus</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
