<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <head>
        <css src="MageOS_Company::css/company.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="company.account.index" template="MageOS_Company::account/index.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">MageOS\Company\ViewModel\CompanyAccount</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
