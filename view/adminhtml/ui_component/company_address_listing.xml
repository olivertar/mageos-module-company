<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">company_address_listing.company_address_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>company_address_columns</spinner>
        <deps>
            <dep>company_address_listing.company_address_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="company_address_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MageOS_Company::company_view</aclResource>
        <dataProvider class="MageOS\Company\Ui\DataProvider\Address\ListingDataProvider"
                      name="company_address_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <filterSearch name="fulltext"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="company_address_columns">
        <column name="label" sortOrder="10">
            <settings>
                <label translate="true">Label</label>
            </settings>
        </column>
        <column name="firstname" sortOrder="20">
            <settings>
                <label translate="true">First Name</label>
            </settings>
        </column>
        <column name="lastname" sortOrder="30">
            <settings>
                <label translate="true">Last Name</label>
            </settings>
        </column>
        <column name="street" sortOrder="40">
            <settings>
                <label translate="true">Street Address</label>
            </settings>
        </column>
        <column name="city" sortOrder="50">
            <settings>
                <label translate="true">City</label>
            </settings>
        </column>
        <column name="region" sortOrder="60">
            <settings>
                <label translate="true">State/Province</label>
            </settings>
        </column>
        <column name="postcode" sortOrder="70">
            <settings>
                <label translate="true">Zip/Postal Code</label>
            </settings>
        </column>
        <column name="country" sortOrder="80">
            <settings>
                <label translate="true">Country</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="telephone" sortOrder="90">
            <settings>
                <label translate="true">Phone Number</label>
            </settings>
        </column>
        <column name="defaults" sortOrder="100">
            <settings>
                <label translate="true">Default For</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <actionsColumn name="actions" class="MageOS\Company\Ui\Component\Listing\Address\Actions"
                       component="MageOS_Company/js/grid/columns/actions" sortOrder="200">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
