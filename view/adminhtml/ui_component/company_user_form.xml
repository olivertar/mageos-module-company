<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd"
      component="Magento_Customer/js/form/components/form">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">company_user_form.company_user_form_data_source</item>
        </item>
        <item name="config" xsi:type="array">
            <item name="deleteConfirmationMessage" translate="true" xsi:type="string">Are you sure you want to remove this customer from the company?</item>
        </item>
        <item name="label" xsi:type="string" translate="true">User</item>
        <item name="reverseMetadataMerge" xsi:type="boolean">true</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="cancel" class="MageOSCompanyUserCancelButton"/>
            <button name="delete" class="MageOSCompanyUserDeleteButton"/>
            <button name="save" class="MageOS\Company\Block\Adminhtml\Modal\SaveButton"/>
        </buttons>
        <namespace>company_user_form</namespace>
        <ajaxSave>true</ajaxSave>
        <ajaxSaveType>simple</ajaxSaveType>
        <dataScope>data</dataScope>
        <deps>
            <dep>company_user_form.company_user_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="company_user_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="mageos_company/user/save"/>
        </settings>
        <aclResource>MageOS_Company::company_edit</aclResource>
        <dataProvider class="MageOS\Company\Ui\DataProvider\User\FormDataProvider"
                      name="company_user_form_data_source">
            <settings>
                <requestFieldName>customer_id</requestFieldName>
                <primaryFieldName>customer_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <container name="messages" component="Magento_Ui/js/form/components/html">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="additionalClasses" xsi:type="string">message message-error</item>
                <item name="visible" xsi:type="boolean">false</item>
                <item name="imports" xsi:type="array">
                    <item name="responseData" xsi:type="string">${ $.parentName }:responseData</item>
                </item>
                <item name="listens" xsi:type="array">
                    <item name="responseData.error" xsi:type="string">visible</item>
                    <item name="responseData.messages" xsi:type="string">content</item>
                </item>
            </item>
        </argument>
    </container>
    <fieldset name="general">
        <settings>
            <label/>
            <dataScope/>
        </settings>
        <field name="customer_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
            </settings>
        </field>
        <field name="company_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
            </settings>
        </field>
        <field name="email" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Customer Email</label>
                <notice translate="true">The customer must exist in the company website and not belong to another company.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-email" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="role" formElement="select" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Role</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="MageOS\Company\Model\CompanyCustomer\Source\Role"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="job_title" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Job Title</label>
                <validation>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                </validation>
            </settings>
        </field>
        <field name="status" formElement="select" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Status</label>
                <notice translate="true">Inactive users cannot sign in nor act for the company.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="MageOS\Company\Model\CompanyCustomer\Source\Status"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
