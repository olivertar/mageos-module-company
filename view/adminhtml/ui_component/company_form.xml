<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">company_form.company_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Company Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="MageOS\Company\Block\Adminhtml\Company\Edit\BackButton"/>
            <button name="delete" class="MageOS\Company\Block\Adminhtml\Company\Edit\DeleteButton"/>
            <button name="status_approve" class="MageOSCompanyApproveButton"/>
            <button name="status_reject" class="MageOSCompanyRejectButton"/>
            <button name="status_block" class="MageOSCompanyBlockButton"/>
            <button name="status_unblock" class="MageOSCompanyUnblockButton"/>
            <button name="status_resubmit" class="MageOSCompanyResubmitButton"/>
            <button name="save_and_continue" class="MageOS\Company\Block\Adminhtml\Company\Edit\SaveAndContinueButton"/>
            <button name="save" class="MageOS\Company\Block\Adminhtml\Company\Edit\SaveButton"/>
        </buttons>
        <namespace>company_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>company_form.company_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="company_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="mageos_company/company/save"/>
        </settings>
        <aclResource>MageOS_Company::company_view</aclResource>
        <dataProvider class="MageOS\Company\Ui\DataProvider\Company\FormDataProvider" name="company_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <collapsible>true</collapsible>
            <opened>true</opened>
            <label translate="true">Company Information</label>
            <dataScope>company</dataScope>
        </settings>
        <field name="entity_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
                <dataScope>entity_id</dataScope>
            </settings>
        </field>
    </fieldset>
    <fieldset name="addresses" sortOrder="20">
        <settings>
            <collapsible>true</collapsible>
            <opened>true</opened>
            <label translate="true">Addresses</label>
        </settings>
        <button name="add_addresses">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="buttonClasses" xsi:type="string">action-secondary</item>
                    <item name="actions" xsi:type="array">
                        <item name="0" xsi:type="array">
                            <item name="targetName" xsi:type="string">${ $.parentName }.addresses_modal.addresses_form_loader</item>
                            <item name="actionName" xsi:type="string">destroyInserted</item>
                        </item>
                        <item name="1" xsi:type="array">
                            <item name="targetName" xsi:type="string">${ $.parentName }.addresses_modal</item>
                            <item name="actionName" xsi:type="string">openModal</item>
                        </item>
                        <item name="2" xsi:type="array">
                            <item name="targetName" xsi:type="string">${ $.parentName }.addresses_modal.addresses_form_loader</item>
                            <item name="actionName" xsi:type="string">render</item>
                        </item>
                    </item>
                </item>
            </argument>
            <settings>
                <title translate="true">Add New Address</title>
            </settings>
        </button>
        <modal name="addresses_modal">
            <settings>
                <options>
                    <option name="title" xsi:type="string" translate="true">Add/Update Address</option>
                </options>
            </settings>
            <insertForm name="addresses_form_loader" component="MageOS_Company/js/form/components/insert-form">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="listingProvider" xsi:type="string">ns = company_address_listing, index = company_address_listing</item>
                        <item name="modalProvider" xsi:type="string">${ $.parentName }</item>
                    </item>
                </argument>
                <settings>
                    <formSubmitType>ajax</formSubmitType>
                    <renderUrl path="mui/index/render_handle">
                        <param name="handle">mageos_company_address_edit</param>
                        <param name="buttons">1</param>
                    </renderUrl>
                    <loading>false</loading>
                    <toolbarContainer>${ $.parentName }</toolbarContainer>
                    <externalProvider>${ $.ns }.company_address_form_data_source</externalProvider>
                    <ns>company_address_form</ns>
                    <exports>
                        <link name="parentId">${ $.externalProvider }:data.parent_id</link>
                    </exports>
                    <imports>
                        <link name="parentId">${ $.provider }:data.company.entity_id</link>
                        <link name="onDelete">${ $.ns }.${ $.ns }:deleteAddressAction</link>
                    </imports>
                </settings>
            </insertForm>
        </modal>
        <insertListing name="company_address_listing">
            <settings>
                <dataLinks>
                    <exports>false</exports>
                    <imports>true</imports>
                </dataLinks>
                <externalProvider>company_address_listing.company_address_listing_data_source</externalProvider>
                <autoRender>true</autoRender>
                <dataScope>company_address_listing</dataScope>
                <ns>company_address_listing</ns>
                <exports>
                    <link name="companyId">${ $.externalProvider }:params.company_id</link>
                </exports>
                <imports>
                    <link name="companyId">${ $.provider }:data.company.entity_id</link>
                </imports>
            </settings>
        </insertListing>
    </fieldset>
    <fieldset name="users" sortOrder="30">
        <settings>
            <collapsible>true</collapsible>
            <opened>true</opened>
            <label translate="true">Users</label>
        </settings>
        <button name="add_users">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="buttonClasses" xsi:type="string">action-secondary</item>
                    <item name="actions" xsi:type="array">
                        <item name="0" xsi:type="array">
                            <item name="targetName" xsi:type="string">${ $.parentName }.users_modal.users_form_loader</item>
                            <item name="actionName" xsi:type="string">destroyInserted</item>
                        </item>
                        <item name="1" xsi:type="array">
                            <item name="targetName" xsi:type="string">${ $.parentName }.users_modal</item>
                            <item name="actionName" xsi:type="string">openModal</item>
                        </item>
                        <item name="2" xsi:type="array">
                            <item name="targetName" xsi:type="string">${ $.parentName }.users_modal.users_form_loader</item>
                            <item name="actionName" xsi:type="string">render</item>
                        </item>
                    </item>
                </item>
            </argument>
            <settings>
                <title translate="true">Assign Customer</title>
            </settings>
        </button>
        <modal name="users_modal">
            <settings>
                <options>
                    <option name="title" xsi:type="string" translate="true">Assign/Update User</option>
                </options>
            </settings>
            <insertForm name="users_form_loader" component="MageOS_Company/js/form/components/insert-form">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="listingProvider" xsi:type="string">ns = company_user_listing, index = company_user_listing</item>
                        <item name="modalProvider" xsi:type="string">${ $.parentName }</item>
                    </item>
                </argument>
                <settings>
                    <formSubmitType>ajax</formSubmitType>
                    <renderUrl path="mui/index/render_handle">
                        <param name="handle">mageos_company_user_edit</param>
                        <param name="buttons">1</param>
                    </renderUrl>
                    <loading>false</loading>
                    <toolbarContainer>${ $.parentName }</toolbarContainer>
                    <externalProvider>${ $.ns }.company_user_form_data_source</externalProvider>
                    <ns>company_user_form</ns>
                    <exports>
                        <link name="parentId">${ $.externalProvider }:data.company_id</link>
                    </exports>
                    <imports>
                        <link name="parentId">${ $.provider }:data.company.entity_id</link>
                        <link name="onDelete">${ $.ns }.${ $.ns }:deleteAddressAction</link>
                    </imports>
                </settings>
            </insertForm>
        </modal>
        <insertListing name="company_user_listing">
            <settings>
                <dataLinks>
                    <exports>false</exports>
                    <imports>true</imports>
                </dataLinks>
                <externalProvider>company_user_listing.company_user_listing_data_source</externalProvider>
                <autoRender>true</autoRender>
                <dataScope>company_user_listing</dataScope>
                <ns>company_user_listing</ns>
                <exports>
                    <link name="companyId">${ $.externalProvider }:params.company_id</link>
                </exports>
                <imports>
                    <link name="companyId">${ $.provider }:data.company.entity_id</link>
                </imports>
            </settings>
        </insertListing>
    </fieldset>
    <fieldset name="messages" sortOrder="35">
        <settings>
            <collapsible>true</collapsible>
            <opened>false</opened>
            <label translate="true">Messages</label>
        </settings>
        <htmlContent name="messages_content">
            <block acl="MageOS_Company::messages" class="MageOS\Company\Block\Adminhtml\Company\Edit\Messages"
                   name="mageos_company_messages" template="MageOS_Company::company/messages.phtml">
                <block class="MageOS\Company\Block\Adminhtml\Company\Edit\Messages"
                       name="mageos_company_messages_thread" as="thread"
                       template="MageOS_Company::company/messages/thread.phtml"/>
            </block>
        </htmlContent>
    </fieldset>
    <fieldset name="history" sortOrder="40">
        <settings>
            <collapsible>true</collapsible>
            <opened>false</opened>
            <label translate="true">Status History</label>
        </settings>
        <htmlContent name="history_content">
            <block class="MageOS\Company\Block\Adminhtml\Company\Edit\History" name="mageos_company_history"
                   template="MageOS_Company::company/history.phtml"/>
        </htmlContent>
    </fieldset>
</form>
