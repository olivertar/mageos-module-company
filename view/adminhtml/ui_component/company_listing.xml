<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">company_listing.company_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Company</label>
                <aclResource>MageOS_Company::company_edit</aclResource>
            </button>
        </buttons>
        <spinner>company_columns</spinner>
        <deps>
            <dep>company_listing.company_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="company_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MageOS_Company::company_view</aclResource>
        <dataProvider class="MageOS\Company\Ui\DataProvider\Company\ListingDataProvider"
                      name="company_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction" class="MageOS\Company\Ui\Component\MassAction"
                    component="MageOS_Company/js/grid/massactions">
            <action name="approve">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="aclResource" xsi:type="string">MageOS_Company::company_approve</item>
                        <item name="prompt" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Approve Companies</item>
                            <item name="label" xsi:type="string" translate="true">Comment (optional)</item>
                            <item name="required" xsi:type="boolean">false</item>
                        </item>
                    </item>
                </argument>
                <settings>
                    <url path="mageos_company/company/massStatus">
                        <param name="status_action">approve</param>
                    </url>
                    <type>approve</type>
                    <label translate="true">Approve</label>
                </settings>
            </action>
            <action name="reject">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="aclResource" xsi:type="string">MageOS_Company::company_approve</item>
                        <item name="prompt" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Reject Companies</item>
                            <item name="label" xsi:type="string" translate="true">Reason</item>
                            <item name="required" xsi:type="boolean">true</item>
                        </item>
                    </item>
                </argument>
                <settings>
                    <url path="mageos_company/company/massStatus">
                        <param name="status_action">reject</param>
                    </url>
                    <type>reject</type>
                    <label translate="true">Reject</label>
                </settings>
            </action>
            <action name="block">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="aclResource" xsi:type="string">MageOS_Company::company_approve</item>
                        <item name="prompt" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Block Companies</item>
                            <item name="label" xsi:type="string" translate="true">Reason</item>
                            <item name="required" xsi:type="boolean">true</item>
                        </item>
                    </item>
                </argument>
                <settings>
                    <url path="mageos_company/company/massStatus">
                        <param name="status_action">block</param>
                    </url>
                    <type>block</type>
                    <label translate="true">Block</label>
                </settings>
            </action>
            <action name="unblock">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="aclResource" xsi:type="string">MageOS_Company::company_approve</item>
                        <item name="prompt" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Unblock Companies</item>
                            <item name="label" xsi:type="string" translate="true">Comment (optional)</item>
                            <item name="required" xsi:type="boolean">false</item>
                        </item>
                    </item>
                </argument>
                <settings>
                    <url path="mageos_company/company/massStatus">
                        <param name="status_action">unblock</param>
                    </url>
                    <type>unblock</type>
                    <label translate="true">Unblock</label>
                </settings>
            </action>
            <action name="delete">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="aclResource" xsi:type="string">MageOS_Company::company_delete</item>
                    </item>
                </argument>
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete the selected companies? Their addresses and user assignments will be deleted too.</message>
                        <title translate="true">Delete Companies</title>
                    </confirm>
                    <url path="mageos_company/company/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="company_columns" class="MageOS\Company\Ui\Component\Listing\Columns">
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Company Name</label>
            </settings>
        </column>
        <column name="email" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Company Email</label>
            </settings>
        </column>
        <column name="status" class="MageOS\Company\Ui\Component\Listing\Column\Status" sortOrder="40">
            <settings>
                <filter>select</filter>
                <options class="MageOS\Company\Model\Company\Attribute\Source\Status"/>
                <dataType>select</dataType>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="company_id" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">ERP Code</label>
            </settings>
        </column>
        <column name="website_id" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <filter>select</filter>
                <options class="Magento\Customer\Model\Customer\Attribute\Source\Website"/>
                <dataType>select</dataType>
                <label translate="true">Website</label>
            </settings>
        </column>
        <column name="super_user_name" sortOrder="500">
            <settings>
                <label translate="true">Super User</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="super_user_email" sortOrder="505">
            <settings>
                <label translate="true">Super User Email</label>
                <sortable>false</sortable>
                <visible>false</visible>
            </settings>
        </column>
        <column name="users_count" sortOrder="510">
            <settings>
                <label translate="true">Users</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="520">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="530">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="unread_messages" sortOrder="540">
            <settings>
                <label translate="true">Unread Messages</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <actionsColumn name="actions" class="MageOS\Company\Ui\Component\Listing\Column\CompanyActions"
                       sortOrder="1000">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
