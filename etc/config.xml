<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <company>
            <general>
                <active>1</active>
                <auto_approve>0</auto_approve>
                <vat_validation>format</vat_validation>
            </general>
            <registration>
                <enabled>1</enabled>
                <terms_enabled>0</terms_enabled>
                <status_link_lifetime>30</status_link_lifetime>
            </registration>
            <email>
                <identity>general</identity>
                <application_received_template>company_email_application_received_template</application_received_template>
                <admin_new_application_template>company_email_admin_new_application_template</admin_new_application_template>
                <approved_template>company_email_approved_template</approved_template>
                <rejected_template>company_email_rejected_template</rejected_template>
                <blocked_template>company_email_blocked_template</blocked_template>
                <unblocked_template>company_email_unblocked_template</unblocked_template>
                <new_message_customer_template>company_email_new_message_customer_template</new_message_customer_template>
                <new_message_admin_template>company_email_new_message_admin_template</new_message_admin_template>
                <invitation_template>company_email_invitation_template</invitation_template>
            </email>
            <users>
                <invitation_lifetime>7</invitation_lifetime>
            </users>
            <messages>
                <max_length>2000</max_length>
                <rate_limit>20</rate_limit>
            </messages>
        </company>
        <recaptcha_frontend>
            <type_for>
                <company_register/>
            </type_for>
        </recaptcha_frontend>
    </default>
</config>
