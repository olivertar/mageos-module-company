<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="company_save_commit_after">
        <observer name="mageos_company_grid_reindex" instance="MageOS\Company\Observer\Grid\ReindexCompany"/>
    </event>
    <event name="company_delete_commit_after">
        <observer name="mageos_company_grid_reindex" instance="MageOS\Company\Observer\Grid\ReindexCompany"/>
    </event>
    <event name="company_entity_attribute_save_after">
        <observer name="mageos_company_grid_invalidate"
                  instance="MageOS\Company\Observer\Grid\InvalidateOnAttributeChange"/>
    </event>
    <event name="company_entity_attribute_delete_after">
        <observer name="mageos_company_grid_invalidate"
                  instance="MageOS\Company\Observer\Grid\InvalidateOnAttributeChange"/>
    </event>
</config>
